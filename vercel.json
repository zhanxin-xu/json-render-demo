{
  "version": 2,
  "builds": [
    {
      "src": "apps/web",
      "use": "@vercel/static-build"
    },
    {
      "src": "apps/server",
      "use": "@vercel/node@latest"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/server/src/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/dist/$1"
    }
  ]
}