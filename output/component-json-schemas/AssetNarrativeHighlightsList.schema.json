{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the narrative highlight."
          },
          "description": {
            "type": "string",
            "description": "Supporting narrative text for the highlight."
          }
